# ==============================================================================
# E-Commerce Trend Arbitrage & Market Saturation Engine Configuration
# ==============================================================================

# --- Telegram Notification Settings ---
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_channel_or_chat_id_here"
TELEGRAM_ENABLED=false

# --- Meta Official API (Optional 100% SLA Zero-Ban Alternative) ---
# Free User Access Token from developers.facebook.com -> Tools -> Graph API Explorer
# Leave blank to use Playwright stealth web scraper
META_ACCESS_TOKEN=""

# --- Ingestion & Western Ad Trends Filter ---
# Comma-separated list of high-intent dropshipping keywords
AD_KEYWORDS="50% off free shipping,get yours today,limited stock,order now while supplies last,buy 1 get 1 free"
# Comma-separated country codes (ISO 3166-1 alpha-2)
SEARCH_COUNTRIES="US,GB,CA,AU"
# Proof of profitability threshold: keep only ads running >= N days
MIN_AD_ACTIVE_DAYS=7
# Maximum ads to inspect per keyword batch
MAX_ADS_PER_KEYWORD=15

# --- Browser & Anti-Bot Stealth Settings ---
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
MAX_CONCURRENT_TASKS=3
ROTATE_USER_AGENTS=true
# Optional proxy (HTTP or SOCKS5): e.g., http://user:pass@host:port
PROXY_SERVER=""

# --- India Saturation & Competition Thresholds ---
MEESHO_ENABLED=true
AMAZON_IN_ENABLED=true
META_INDIA_ENABLED=true

# Visual Match Settings
VISUAL_MATCH_ENABLED=true
# Hamming distance similarity threshold (0.0 to 1.0, higher = stricter)
VISUAL_SIMILARITY_THRESHOLD=0.80

# Saturation Tier Cutoffs
# VIRGIN: <= MAX listings on Meesho AND <= MAX India ads
VIRGIN_MAX_MEESHO_LISTINGS=2
VIRGIN_MAX_INDIA_ADS=0
# EARLY: <= MAX listings on Meesho AND <= MAX India ads
EARLY_MAX_MEESHO_LISTINGS=8
EARLY_MAX_INDIA_ADS=2

# --- Unit Economics & India Feasibility Filter ---
# Recommended sweet spot retail price in INR for Indian impulse buy
MIN_TARGET_PRICE_INR=699.0
MAX_TARGET_PRICE_INR=1499.0

# USD to INR conversion rate for sourcing cross-calculations
USD_TO_INR_RATE=83.5

# Minimum Arbitrage Score (0-100) required to trigger Telegram Alert
MIN_ARBITRAGE_SCORE_TO_NOTIFY=65.0

# --- High RTO Risk Detection ---
# Categories with elevated Return-to-Origin rates in India COD dropshipping
RTO_FRAGILE_KEYWORDS="glass,ceramic,mirror,porcelain,fragile,crystal,cup,mug"
RTO_LIQUID_KEYWORDS="serum,liquid,cream,oil,perfume,shampoo,lotion,spray,gel,fluid"
RTO_HEAVY_KEYWORDS="dumbbell,heavy,gym,weight,sofa,furniture,table,chair,overweight"
